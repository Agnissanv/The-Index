    <div>
      <p class="font-display font-semibold text-lg">The Index</p>
      <p class="text-sm text-ink-muted mt-1 max-w-md">
      A hand-checked catalog of AI tools worth knowing about. New entries added weekly.
      </p>
    </div>
    <div class="font-mono text-xs text-ink-muted">
      <p>&copy; {year} The Index.</p>
      <p class="mt-1">Some links are affiliate links. See our <a href="/disclosure" class="underline hover:text-ink">disclosure</a>.</p>
      <p class="mt-1">Built by <a href="https://www.agnissanisaac.com/" target="_blank" rel="noopener noreferrer" class="underline hover:text-teal">Code A-Z</a>.</p>
    </div>
  </div>
