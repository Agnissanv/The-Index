---
interface Props {
  slug: string;
  name: string;
  tagline: string;
  category: string;
  pricing: "free" | "freemium" | "paid";
  catalogNo: string;
  website: string;
  featured?: boolean;
}

const { slug, name, tagline, category, pricing, catalogNo, website, featured } = Astro.props;
const logoDomain = new URL(website).hostname;

const pricingLabel: Record<string, string> = {
  free: "Free",
  freemium: "Freemium",
  paid: "Paid",
};
---

<div class="catalog-card group relative block bg-card border border-line rounded-lg p-5 pt-7 hover:border-teal hover:-translate-y-0.5 transition-all shadow-sm hover:shadow-md">
  <a href={`/tools/${slug}`} class="absolute inset-0 z-0" aria-label={name}></a>

  <div class="relative z-10 pointer-events-none">
    <div class="flex items-center justify-between mb-3">
      <div class="flex items-center gap-2">
        <img
          src={`https://www.google.com/s2/favicons?domain=${logoDomain}&sz=64`}
          alt=""
          width="24"
          height="24"
          class="rounded-md"
          loading="lazy"
        />
        <span class="font-mono text-[11px] text-ink-muted tracking-wider">No. {catalogNo}</span>
      </div>
      {featured && (
        <span class="font-mono text-[10px] uppercase tracking-wider bg-brass-soft text-brass border border-brass/30 rounded-full px-2 py-0.5">
          Featured
        </span>
      )}
    </div>

    <h3 class="font-display font-semibold text-xl leading-tight group-hover:text-teal transition-colors">
      {name}
    </h3>
    <p class="text-sm text-ink-muted mt-1.5 leading-snug">{tagline}</p>

    <div class="flex items-center gap-2 mt-4 pt-4 border-t border-dashed border-line">
      <span class="font-mono text-[11px] uppercase tracking-wide text-ink-muted">{category}</span>
      <span class="text-line">·</span>
      <span class="font-mono text-[11px] uppercase tracking-wide text-teal">{pricingLabel[pricing]}</span>
    </div>

    <div class="relative z-20 mt-3 flex items-center gap-3 pointer-events-auto">
      <label class="flex items-center gap-2 text-xs font-mono text-ink-muted cursor-pointer w-max hover:text-teal transition-colors">
        <input
          type="checkbox"
          class="compare-checkbox w-3.5 h-3.5 accent-teal cursor-pointer"
          data-slug={slug}
          data-name={name}
          data-category={category}
          data-pricing={pricingLabel[pricing]}
        />
        Compare
      </label>

      <button
        type="button"
        class="favorite-toggle flex items-center gap-1 text-xs font-mono text-ink-muted hover:text-brass transition-colors"
        data-slug={slug}
        data-name={name}
        aria-label={`Save ${name} to favorites`}
      >
        <span class="favorite-star">&#9734;</span>
        Save
      </button>
    </div>
  </div>
</div>