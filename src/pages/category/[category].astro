---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import ToolCard from '../../components/ToolCard.astro';
import { categoryMeta } from '../../data/categories';

export async function getStaticPaths() {
  return Object.keys(categoryMeta).map((slug) => ({ params: { category: slug } }));
}

const { category } = Astro.params;
const meta = categoryMeta[category as string];
const tools = (await getCollection('tools')).filter((t) => t.data.category === category);
---

<Layout
  title={`${meta.label} tools`}
  description={`${meta.blurb} Hand-checked AI tools filed under ${meta.label}.`}
>
  <section class="max-w-6xl mx-auto px-6 pt-14 pb-8">
    <a href="/" class="font-mono text-xs text-ink-muted hover:text-teal">&larr; Back to catalog</a>
    <p class="font-mono text-xs uppercase tracking-widest text-brass mt-6 mb-3">Category</p>
    <h1 class="font-display text-4xl sm:text-5xl font-semibold">{meta.label}</h1>
    <p class="text-ink-muted text-lg mt-3 max-w-xl">{meta.blurb}</p>
  </section>

  <section class="max-w-6xl mx-auto px-6 py-8 pb-24">
    <div class="flex items-baseline justify-between mb-6">
      <h2 class="font-mono text-xs uppercase tracking-wide text-ink-muted">{tools.length} entries</h2>
    </div>
    {tools.length > 0 ? (
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
        {tools.map((tool) => (
          <ToolCard
            slug={tool.id}
            name={tool.data.name}
            tagline={tool.data.tagline}
            category={tool.data.category}
            pricing={tool.data.pricing}
            catalogNo={tool.data.catalogNo}
            website={tool.data.website}
            featured={tool.data.featured}
          />
        ))}
      </div>
    ) : (
      <p class="text-ink-muted text-sm">No entries filed here yet. Check back soon.</p>
    )}
  </section>
</Layout>
