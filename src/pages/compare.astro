---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';

const allTools = await getCollection('tools');
const toolsData = allTools.map((t) => ({
  slug: t.id,
  name: t.data.name,
  tagline: t.data.tagline,
  website: t.data.website,
  affiliateUrl: t.data.affiliateUrl ?? t.data.website,
  pricing: t.data.pricing,
  startingPrice: t.data.startingPrice ?? "",
  pros: t.data.pros,
  cons: t.data.cons,
  bestFor: t.data.bestFor,
}));

const pricingLabel: Record<string, string> = {
  free: "Free",
  freemium: "Freemium",
  paid: "Paid",
};
---

<Layout
  title="Compare AI Tools"
  description="Compare AI tools side by side: pricing, strengths, and trade-offs."
>
  <section class="max-w-6xl mx-auto px-6 pt-14 pb-8">
    <a href="/" class="font-mono text-xs text-ink-muted hover:text-teal">&larr; Back to catalog</a>
    <p class="font-mono text-xs uppercase tracking-widest text-brass mt-6 mb-3">Compare</p>
    <h1 class="font-display text-4xl sm:text-5xl font-semibold">Side by side</h1>
    <p class="text-ink-muted text-lg mt-3 max-w-xl">
      Pick tools from the catalog to compare pricing, strengths, and trade-offs in one view.
    </p>
  </section>

  <section class="max-w-6xl mx-auto px-6 pb-24">
    <div id="compare-empty" class="bg-card border border-line rounded-lg p-10 text-center hidden">
      <p class="text-ink-muted">No tools selected yet.</p>
      <a href="/" class="inline-block mt-4 font-mono text-xs uppercase tracking-wide bg-ink text-paper rounded-full px-5 py-3 hover:bg-teal transition-colors">
        Browse the catalog
      </a>
    </div>

    <div id="compare-grid" class="grid gap-4 hidden"></div>
  </section>

  <script type="application/json" id="tools-data" set:html={JSON.stringify(toolsData)} />
  <script type="application/json" id="pricing-labels" set:html={JSON.stringify(pricingLabel)} />

  <script>
    type ToolData = {
      slug: string;
      name: string;
      tagline: string;
      website: string;
      affiliateUrl: string;
      pricing: string;
      startingPrice: string;
      pros: string[];
      cons: string[];
      bestFor: string;
    };

    const dataEl = document.getElementById("tools-data");
    const labelsEl = document.getElementById("pricing-labels");
    const allTools: ToolData[] = dataEl ? JSON.parse(dataEl.textContent || "[]") : [];
    const pricingLabel: Record<string, string> = labelsEl ? JSON.parse(labelsEl.textContent || "{}") : {};

    const params = new URLSearchParams(window.location.search);
    const slugs = (params.get("tools") || "").split(",").map((s) => s.trim()).filter(Boolean);
    const selected = slugs
      .map((slug) => allTools.find((t) => t.slug === slug))
      .filter((t): t is ToolData => Boolean(t));

    const emptyEl = document.getElementById("compare-empty");
    const gridEl = document.getElementById("compare-grid");

    function escapeHtml(str: string) {
      const div = document.createElement("div");
      div.textContent = str;
      return div.innerHTML;
    }

    if (!emptyEl || !gridEl) {
      // Nothing to render into, stop here
    } else if (selected.length === 0) {
      emptyEl.classList.remove("hidden");
    } else {
      gridEl.classList.remove("hidden");
      gridEl.style.gridTemplateColumns = `repeat(${selected.length}, minmax(0, 1fr))`;

      gridEl.innerHTML = selected.map((tool) => {
        const domain = new URL(tool.website).hostname;
        const priceLine = pricingLabel[tool.pricing] + (tool.startingPrice ? ` · ${tool.startingPrice}` : "");

        const prosHtml = tool.pros.map((pro) => `
          <li class="text-sm flex gap-2">
            <span class="text-teal mt-0.5">+</span>
            <span>${escapeHtml(pro)}</span>
          </li>
        `).join("");

        const consHtml = tool.cons.map((con) => `
          <li class="text-sm flex gap-2">
            <span class="text-brass mt-0.5">&minus;</span>
            <span>${escapeHtml(con)}</span>
          </li>
        `).join("");

        return `
          <div class="catalog-card bg-card border border-line rounded-lg p-6 pt-8">
            <img
              src="https://www.google.com/s2/favicons?domain=${domain}&sz=64"
              alt=""
              width="32"
              height="32"
              class="rounded-md mb-3"
              loading="lazy"
            />
            <h2 class="font-display text-xl font-semibold">
              <a href="/tools/${tool.slug}" class="hover:text-teal transition-colors">${escapeHtml(tool.name)}</a>
            </h2>
            <p class="text-sm text-ink-muted mt-1">${escapeHtml(tool.tagline)}</p>

            <div class="mt-4 pt-4 border-t border-dashed border-line">
              <p class="font-mono text-[11px] uppercase tracking-wide text-ink-muted mb-1">Pricing</p>
              <p class="text-sm">${escapeHtml(priceLine)}</p>
            </div>

            <div class="mt-4 pt-4 border-t border-dashed border-line">
              <p class="font-mono text-[11px] uppercase tracking-wide text-teal mb-2">Strengths</p>
              <ul class="space-y-1.5">${prosHtml}</ul>
            </div>

            <div class="mt-4 pt-4 border-t border-dashed border-line">
              <p class="font-mono text-[11px] uppercase tracking-wide text-brass mb-2">Trade-offs</p>
              <ul class="space-y-1.5">${consHtml}</ul>
            </div>

            <div class="mt-4 pt-4 border-t border-dashed border-line">
              <p class="font-mono text-[11px] uppercase tracking-wide text-ink-muted mb-1">Best for</p>
              <p class="text-sm">${escapeHtml(tool.bestFor)}</p>
            </div>

            <a
              href="${tool.affiliateUrl}"
              target="_blank"
              rel="noopener noreferrer sponsored"
              class="block text-center mt-5 font-mono text-xs uppercase tracking-wide bg-ink text-paper rounded-full px-4 py-2.5 hover:bg-teal transition-colors"
            >
              Visit ${escapeHtml(tool.name)} &rarr;
            </a>
          </div>
        `;
      }).join("");
    }
  </script>
</Layout>