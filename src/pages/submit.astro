---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Submit a tool"
  description="Submit an AI tool to be reviewed and added to The Index."
>
  <section class="max-w-2xl mx-auto px-6 py-16">
    <a href="/" class="font-mono text-xs text-ink-muted hover:text-teal">&larr; Back to catalog</a>

    <p class="font-mono text-xs uppercase tracking-widest text-brass mt-6 mb-3">Submissions</p>
    <h1 class="font-display text-4xl font-semibold">Submit a tool</h1>
    <p class="text-ink-muted text-lg mt-3">
      Building or running an AI tool? Tell us about it. Every submission is tried by hand before it's added
      to the catalog — no pay-to-list entries.
    </p>

    <!--
      Replace YOUR_FORM_ID below with a real Formspree (or similar) form ID.
      Sign up free at https://formspree.io, create a form, and paste the ID here.
    -->
    <form
      action="https://formspree.io/f/YOUR_FORM_ID"
      method="POST"
      class="mt-10 space-y-5 bg-card border border-line rounded-xl p-6"
    >
      <div>
        <label for="tool-name" class="font-mono text-xs uppercase tracking-wide text-ink-muted block mb-2">
          Tool name
        </label>
        <input
          id="tool-name" name="tool-name" type="text" required
          class="w-full bg-paper border border-line rounded-lg px-4 py-3 text-sm focus:border-teal outline-none"
        />
      </div>

      <div>
        <label for="website" class="font-mono text-xs uppercase tracking-wide text-ink-muted block mb-2">
          Website
        </label>
        <input
          id="website" name="website" type="url" required placeholder="https://"
          class="w-full bg-paper border border-line rounded-lg px-4 py-3 text-sm focus:border-teal outline-none"
        />
      </div>

      <div>
        <label for="category" class="font-mono text-xs uppercase tracking-wide text-ink-muted block mb-2">
          Category
        </label>
        <select
          id="category" name="category" required
          class="w-full bg-paper border border-line rounded-lg px-4 py-3 text-sm focus:border-teal outline-none"
        >
          <option value="writing">Writing</option>
          <option value="image">Image</option>
          <option value="video">Video</option>
          <option value="audio">Audio</option>
          <option value="coding">Coding</option>
          <option value="productivity">Productivity</option>
          <option value="research">Research</option>
          <option value="design">Design</option>
        </select>
      </div>

      <div>
        <label for="description" class="font-mono text-xs uppercase tracking-wide text-ink-muted block mb-2">
          What does it do?
        </label>
        <textarea
          id="description" name="description" rows="4" required
          class="w-full bg-paper border border-line rounded-lg px-4 py-3 text-sm focus:border-teal outline-none"
        ></textarea>
      </div>

      <div>
        <label for="email" class="font-mono text-xs uppercase tracking-wide text-ink-muted block mb-2">
          Contact email
        </label>
        <input
          id="email" name="email" type="email" required
          class="w-full bg-paper border border-line rounded-lg px-4 py-3 text-sm focus:border-teal outline-none"
        />
      </div>

      <button
        type="submit"
        class="font-mono text-sm uppercase tracking-wide bg-ink text-paper rounded-full px-6 py-3 hover:bg-teal transition-colors"
      >
        Submit for review
      </button>
    </form>
  </section>
</Layout>
